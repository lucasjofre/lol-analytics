# Copy to .env and fill in. .env is gitignored.

# --- Riot API (local ingestion) ---
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_REGION=euw1

# --- Databricks (upload target + dbt) ---
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# --- dbt ---
DBT_CATALOG=lol_analytics
DBT_SCHEMA=dev_marts

# --- Local ingestion sink ---
# Where the local crawler writes before uploading to the UC volume.
LOL_LANDING_PATH=./data/landing
